# ---------------------------------------------------------------------------
# StudioFlow AI frontend. Copy to .env and adjust.
#
# !!! EVERY VITE_ VARIABLE IS BUNDLED INTO PUBLIC JAVASCRIPT !!!
# NEVER put the Supabase SERVICE-ROLE key, the OpenAI API key, database
# passwords or any other secret in this file. Those belong ONLY in the server's
# environment (Railway). The Supabase anon/publishable key below is public by
# design and is the only Supabase key the browser may use.
# ---------------------------------------------------------------------------

# "api" (default) uses the Node.js backend + Supabase Auth. Production MUST use api.
# "mock" runs entirely in the browser with demo data and simulated AI, for local
# development/demos only. `npm run build` refuses mock mode unless
# VITE_ALLOW_DEMO_BUILD=true is also set.
VITE_DATA_MODE=api

# Node.js API base URL INCLUDING /api/v1 (local or Railway).
# Production example: https://your-service.up.railway.app/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Supabase project URL and anon/publishable key (api mode only).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Simulated network latency for mock services (ms). Ignored in api mode.
VITE_MOCK_LATENCY_MS=250

# Upload size limit shown/enforced in the browser (must match the API's MAX_UPLOAD_SIZE_MB)
VITE_MAX_UPLOAD_MB=15

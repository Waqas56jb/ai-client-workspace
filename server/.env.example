# ─────────────────────────────────────────────────────────────────────────────
# StudioFlow AI API — environment variables (placeholders only).
# Copy to `.env` for local development. NEVER commit `.env`.
# On Railway, set these in the service's Variables tab.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Allowed browser origin(s) for CORS — comma-separated (e.g. your Vercel URL)
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Supabase project
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key — used ONLY to verify user access tokens
SUPABASE_ANON_KEY=<publishable-or-anon-key>
# SECRET — service role (bypasses RLS). Server-side only. Used for private Storage operations
# after the API has authorised the request, and by the provisioning script.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
STORAGE_BUCKET=ai-workspace-files

# Postgres via the Supabase pooler (SECRET password).
# The API uses the TRANSACTION pooler (6543); scripts use the SESSION pooler (5432).
# Either set DATABASE_URL, or the discrete fields below.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
DATABASE_HOST=aws-<n>-<region>.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_MIGRATION_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres.<project-ref>
DATABASE_PASSWORD=<database-password>
DATABASE_POOL_MAX=10

# OpenAI (SECRET key). Models are validated against src/constants/models.js
OPENAI_API_KEY=<openai-api-key>
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional — defaults to OPENAI_IMAGE_MODEL. gpt-image-1 / gpt-image-1.5 edits are sent with input_fidelity=high.
# OPENAI_IMAGE_EDIT_MODEL=gpt-image-2
# Optional — the model that works out what each chat message needs (needs vision + structured output). Defaults to OPENAI_TEXT_MODEL.
# OPENAI_ROUTER_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=180000

# Limits & cost controls
MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_MAX_CONCURRENT_PER_USER=2
IMAGE_MAX_DIMENSION_PX=4096
SIGNED_URL_TTL_SECONDS=300

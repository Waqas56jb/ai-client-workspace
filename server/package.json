{
  "name": "studioflow-ai-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "db:inspect": "node scripts/inspect-db.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "users:provision": "node scripts/provision-user.js",
    "ai:check": "node scripts/check-openai.js",
    "test:live": "vitest run -c vitest.live.config.js",
    "test:live:no-ai": "vitest run -c vitest.live.config.js --exclude tests/live/ai.live.test.js",
    "test:live:ai": "vitest run -c vitest.live.config.js tests/live/ai.live.test.js",
    "test:live:security": "vitest run -c vitest.live.config.js tests/live/security.live.test.js tests/live/auth.live.test.js tests/live/routes.live.test.js",
    "qa:provision": "node scripts/qa/provision-qa-users.js",
    "qa:cleanup": "node scripts/qa/cleanup-qa-data.js",
    "qa:smoke": "node scripts/qa/smoke.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
